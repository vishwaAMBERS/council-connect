PORT=4000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_string
CORS_ORIGIN=http://localhost:5173,http://localhost:8081

# Database. Leave DATABASE_URL empty for the embedded PGlite database (no install needed).
# Set it to a PostgreSQL connection string (e.g. Supabase) to use a real server.
DATABASE_URL=
# TLS for DATABASE_URL: off | require | no-verify. Default: off for localhost, require otherwise.
DATABASE_SSL=
PGLITE_DATA_DIR=.data/pglite

# Where uploaded images are stored (relative to backend/).
UPLOADS_DIR=uploads

# Optional. Server-side only. Without it, AI categorisation uses keyword rules.
ANTHROPIC_API_KEY=
